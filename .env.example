# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase
# (Project Settings > API Keys). Nunca incluyas la clave service_role/secret aquí.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio (redirecciones de correos de Auth). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
